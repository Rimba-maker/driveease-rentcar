---
import { heroColumns } from '../data/site';
const offsets = [0, -90, -40, -130, -20, -70];
const dims = (r: string) => (r === '3/4' ? [600, 800] : [800, 600]);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="sheet">
    {heroColumns.map((col, ci) => (
      <div class={`sheet-col c${ci}`} style={`--off:${offsets[ci]}px`}>
        {col.map((f, fi) => {
          const [w, h] = dims(f.ratio);
          return (
            <figure class={`frame${ci === 1 && fi === 0 ? ' drift' : ''}${ci === 4 && fi === 1 ? ' drift' : ''}`} style={`--r:${f.ratio};--ci:${ci};--fi:${fi}`}>
              <img src={f.src} alt={f.alt} width={w} height={h} loading={fi < 2 ? 'eager' : 'lazy'} decoding="async" />
              <figcaption class={`strip s${(ci + fi) % 4}`}>{f.strip}</figcaption>
            </figure>
          );
        })}
      </div>
    ))}
    <div class="hero-panel">
      <div class="reveal" style="--d:0">
        <h1 id="hero-title" class="display">Rental mobil, siap jalan.</h1>
      </div>
      <p class="lead reveal" style="--d:1; max-width: 46ch">
        Rental mobil yang bisa diandalkan: 200+ unit terawat dari city car sampai sedan eksekutif. Lepas kunci atau with driver, harian sampai bulanan.
      </p>
      <div class="actions reveal" style="--d:2">
        <a href="#armada" class="btn">Cek mobil</a>
        <div class="links">
          <a href="#harga" class="link">Hitung harga</a>
          <a href="#cabang" class="link">8 cabang</a>
          <a href="#booking-form" class="link">Booking cepat</a>
        </div>
      </div>
    </div>
  </div>
</section>
