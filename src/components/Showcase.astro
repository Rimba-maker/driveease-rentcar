---
// One photograph of the lot, cut across a board of square tiles.
const tiles = Array.from({ length: 24 }, (_, i) => i);
const tilesM = Array.from({ length: 12 }, (_, i) => i);
const pos = (i: number, cols: number, rows: number) =>
  `${((i % cols) / (cols - 1)) * 100}% ${(Math.floor(i / cols) / (rows - 1)) * 100}%`;
---

<section class="section" aria-labelledby="showcase-title">
  <p class="sr-only">Foto lapangan parkir unit DriveEase dilihat dari atas, dipotong menjadi papan ubin.</p>
  <!-- desktop: 6 x 4 -->
  <div class="mosaic mosaic--d">
    {tiles.map((i) => {
      const style = `--i:${i}; `;
      if (i === 0) return (
        <div class="mt mt--c tile--ink reveal" style={`${style}--d:0`}>
          <h2 id="showcase-title">Armada kami</h2>
          <span class="lead">Dilihat dari atas, satu per satu.</span>
        </div>
      );
      if (i === 8) return (
        <div class="mt mt--c tile--accent reveal" style={`${style}--d:2`}>
          <span class="big" data-count="200" data-suffix="+">200+</span><span class="lead">unit terawat siap sewa</span>
        </div>
      );
      if (i === 11) return (
        <div class="mt mt--c reveal" style={`${style}--d:3`}>
          <span class="big" data-count="3" data-suffix=" th">3 th</span><span class="lead">umur maksimal setiap mobil</span>
        </div>
      );
      if (i === 15) return (
        <div class="mt mt--c tile--ink reveal" style={`${style}--d:4`}>
          <span class="big" data-count="8">8</span><span class="lead">cabang di kota besar Indonesia</span>
        </div>
      );
      if (i === 22) return (
        <a class="mt mt--c tile--accent reveal tile-hover" href="#armada" style={`${style}--d:5`}>
          <span class="big">Lihat</span><span class="lead">semua mobil dan harganya</span>
        </a>
      );
      return (
        <div class="mt reveal" style={`${style}--d:${(i % 6) + Math.floor(i / 6)}`}>
          <div class="px" style={`background-position:${pos(i, 6, 4)}`}></div>
        </div>
      );
    })}
  </div>

  <!-- phone: 3 x 4 -->
  <div class="mosaic mosaic--m">
    {tilesM.map((i) => {
      if (i === 0) return (
        <div class="mt mt--c tile--ink"><h2>Armada kami</h2></div>
      );
      if (i === 4) return (
        <div class="mt mt--c tile--accent"><span class="big" data-count="200" data-suffix="+">200+</span><span class="lead">unit siap sewa</span></div>
      );
      if (i === 6) return (
        <div class="mt mt--c"><span class="big" data-count="3" data-suffix=" th">3 th</span><span class="lead">umur maks. mobil</span></div>
      );
      if (i === 8) return (
        <div class="mt mt--c tile--ink"><span class="big" data-count="8">8</span><span class="lead">cabang</span></div>
      );
      if (i === 10) return (
        <a class="mt mt--c tile--accent" href="#armada"><span class="big">Lihat</span><span class="lead">semua mobil</span></a>
      );
      return (
        <div class="mt"><div class="px" style={`background-position:${pos(i, 3, 4)}`}></div></div>
      );
    })}
  </div>
</section>
