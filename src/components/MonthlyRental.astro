---
import { CheckCircle2 } from 'lucide-react';

const includes = [
  'Asuransi All Risk',
  'Service Rutin Berkala',
  'Penggantian Unit (Jika Trouble)',
  'Driver Tersedia (Opsional)'
];
---

<section class="py-14 sm:py-20 md:py-24 px-4 sm:px-6 lg:px-8 bg-[var(--color-canvas-soft)]">
  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-12 lg:gap-24">
    <div class="w-full lg:w-1/2">
      <div class="relative rounded-2xl overflow-hidden shadow-lg aspect-[4/3]">
        <img 
          src="https://images.unsplash.com/photo-1541899481282-d53bffe3c35d?auto=format&fit=crop&w=1200&q=80" 
          alt="Business travel car rental" 
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <div class="w-full lg:w-1/2 flex flex-col justify-center">
      <span class="text-sm font-bold tracking-wider uppercase text-[var(--color-body)] mb-2">Long Term Rental</span>
      <h2 class="text-4xl font-bold tracking-tight text-[var(--color-ink)] md:text-5xl mb-6">
        Paket Bulanan Hemat Sampai 40%
      </h2>
      <p class="text-lg text-[var(--color-body)] mb-8">
        Cocok untuk penugasan kerja, expatriate, atau saat mobil pribadi Anda harus masuk bengkel untuk waktu yang lama.
      </p>

      <div class="bg-[var(--color-canvas)] border border-[var(--color-surface-pressed)] rounded-xl p-6 mb-8 shadow-sm">
        <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4">
          <div>
            <span class="text-sm font-medium text-[var(--color-mute)] line-through block">Sewa Harian: Rp 350k × 30 = Rp 10.5jt</span>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="text-3xl font-bold text-[var(--color-ink)]">Rp 6.5jt</span>
              <span class="text-sm font-medium text-[var(--color-body)]">/ bulan</span>
            </div>
          </div>
          <a href="#booking" class="rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-medium text-[var(--color-on-primary)] transition-transform hover:scale-[1.02] text-center">
            Konsultasi Paket
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {includes.map(inc => (
          <div class="flex items-center gap-2">
            <CheckCircle2 size={18} className="text-[var(--color-primary)]" />
            <span class="text-sm font-medium text-[var(--color-ink)]">{inc}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
