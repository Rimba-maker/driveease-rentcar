---
import { WA_LINK, photoCredits } from '../data/site';

const letters = 'DRIVEEASE'.split('');
const heights = [100, 82, 94, 76, 88, 100, 78, 92, 74];
const colors = ['var(--accent)', 'var(--field)', '#8a8a8a', 'var(--accent)', 'var(--field)', '#8a8a8a', 'var(--accent)', 'var(--field)', '#8a8a8a'];
---

<footer class="footer" aria-labelledby="footer-title">
  <h2 id="footer-title" class="sr-only">DriveEase Rentcar</h2>
  <div class="blocks" role="img" aria-label="DriveEase">
    {[letters.slice(0, 5), letters.slice(5)].map((group, g) => (
      <div class="blk-group">
        {group.map((l, j) => {
          const i = g * 5 + j;
          return <span style={`--bh:${heights[i]}%;--bc:${colors[i]}`}>{l}</span>;
        })}
      </div>
    ))}
  </div>

  <div class="foot-grid">
    <div class="foot-links">
      <div>
        <h3>Layanan</h3>
        <ul>
          <li><a class="link" href="#armada">Armada</a></li>
          <li><a class="link" href="#harga">Harga</a></li>
          <li><a class="link" href="#booking-form">Booking</a></li>
        </ul>
      </div>
      <div>
        <h3>Perusahaan</h3>
        <ul>
          <li><a class="link" href="#corporate">Corporate fleet</a></li>
          <li><a class="link" href="#cabang">Cabang</a></li>
          <li><a class="link" href="#faq">Tanya jawab</a></li>
        </ul>
      </div>
      <div>
        <h3>Sertifikasi</h3>
        <ul><li>NIB</li><li>IUP</li></ul>
      </div>
      <div>
        <h3>Mitra asuransi</h3>
        <ul><li>Sinarmas</li><li>Astra</li></ul>
      </div>
    </div>
    <div class="foot-contact">
      <p class="lead strong" style="margin:0">Mobilmu, kemanapun tujuanmu.</p>
      <span>Hotline 24/7 melalui WhatsApp dan telepon</span>
      <span>Instagram, TikTok, YouTube: @driveease.rentcar</span>
    </div>
  </div>

  <div class="foot-bottom">
    <span>&copy; {new Date().getFullYear()} DriveEase Rentcar. Hak cipta dilindungi.</span>
    <a class="btn btn--sm" href={WA_LINK} target="_blank" rel="noopener">Chat WhatsApp</a>
  </div>
  <p class="credits">
    Foto: Pexels (lisensi Pexels), antara lain {photoCredits.join(', ')}, dan kontributor lainnya.
  </p>
</footer>
