---
import { corporate, waLink } from '../data/site';
---

<section id="corporate" class="section wrap" aria-labelledby="corp-title">
  <div class="corp-top">
    <h2 id="corp-title" class="head a reveal">Fleet solution untuk bisnismu</h2>
    <p class="lead b reveal" style="--d:1">
      Kami suplai mobil operasional untuk 50+ perusahaan di Indonesia. Kontrak jangka panjang dengan harga khusus dan laporan custom.
    </p>
  </div>
  <div class="corp-tiles">
    <div class="tile corp-photo reveal">
      <img class="fill" src="/img/handshake.jpg" alt="Dua profesional berjabat tangan setelah menyepakati kontrak" width="1600" height="1067" loading="lazy" decoding="async" />
    </div>
    <div class="tile tile--ink corp-facts reveal" style="--d:1">
      <p class="num">50+</p>
      <ul>
        {corporate.map((c) => (
          <li><b>{c.title}</b><span>{c.text}</span></li>
        ))}
      </ul>
      <a class="btn" style="align-self:flex-start" href={waLink('Halo DriveEase, saya ingin diskusi corporate plan.')} target="_blank" rel="noopener">Diskusi corporate plan</a>
    </div>
  </div>
</section>
