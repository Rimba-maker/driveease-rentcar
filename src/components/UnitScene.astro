---
// Scene: the lot seen from above; one unit grows from a window in it to the whole screen.
---

<section class="scene unit-scene section" data-scene="lot-unit" data-options='{"hold":2.2}' aria-labelledby="unit-title">
  <div class="scene-stage">
    <div class="lot tile">
      <img src="/img/lot-rows.webp" srcset="/img/lot-rows-sm.webp 800w, /img/lot-rows.webp 1600w" sizes="100vw" alt="Barisan unit di lapangan parkir dilihat dari atas" width="1600" height="1067" loading="lazy" decoding="async" />
    </div>
    <div class="unit tile" data-move>
      <img src="/img/car-rangerover.webp" srcset="/img/car-rangerover-sm.webp 800w, /img/car-rangerover.webp 1600w" sizes="100vw" alt="SUV hitam diparkir di jalan berdaun musim gugur" width="1600" height="1067" loading="lazy" decoding="async" />
    </div>
    <p class="unit-tag small strong" aria-hidden="true">Unit pilihanmu</p>
    <div class="unit-card tile--ink">
      <h2 id="unit-title" class="head">Pilih satu dari 200+ unit.</h2>
      <p class="lead">Sisanya kami urus: unit dicek, diasuransikan, dan siap di cabang atau diantar ke lokasimu.</p>
      <a class="btn" href="#harga">Hitung sewanya</a>
    </div>
  </div>
</section>
