---
import { BarChart3, Users, FileText } from 'lucide-react';

const features = [
  {
    title: 'Fleet Management Dashboard',
    desc: 'Pantau penggunaan, jadwal service, dan perpanjangan secara terpusat.',
    icon: BarChart3
  },
  {
    title: 'Dedicated Account Manager',
    desc: 'Satu kontak PIC untuk semua urusan operasional fleet Anda.',
    icon: Users
  },
  {
    title: 'Invoice Tax-Compliant',
    desc: 'Faktur pajak lengkap dan term of payment (TOP) fleksibel.',
    icon: FileText
  }
];
---

<section id="corporate" class="py-14 sm:py-20 md:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-[var(--color-canvas)]">
  <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-24">
    <div class="w-full lg:w-1/2 flex flex-col justify-center">
      <span class="text-sm font-bold tracking-wider uppercase text-[var(--color-body)] mb-2">B2B Services</span>
      <h2 class="text-4xl font-bold tracking-tight text-[var(--color-ink)] md:text-5xl mb-6">
        Fleet Solution Untuk Bisnismu
      </h2>
      <p class="text-lg text-[var(--color-body)] mb-8">
        Kami menyuplai mobil operasional untuk 50+ perusahaan di Indonesia. Nikmati long-term contract dengan harga khusus dan reporting yang custom.
      </p>

      <div class="flex flex-col gap-6 mb-8">
        {features.map(feat => (
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[var(--color-canvas-soft)] flex items-center justify-center">
              <feat.icon size={24} className="text-[var(--color-ink)]" />
            </div>
            <div>
              <h3 class="text-lg font-bold text-[var(--color-ink)] mb-1">{feat.title}</h3>
              <p class="text-sm text-[var(--color-body)]">{feat.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div>
        <a href="#booking" class="inline-flex rounded-full bg-[var(--color-canvas-soft)] px-8 py-4 text-base font-bold text-[var(--color-ink)] transition-colors hover:bg-[var(--color-primary)] hover:text-[var(--color-on-primary)]">
          Diskusi Corporate Plan
        </a>
      </div>
    </div>

    <div class="w-full lg:w-1/2">
      <div class="relative rounded-2xl overflow-hidden shadow-[0_8px_32px_rgba(0,0,0,0.12)]">
        <img 
          src="https://images.unsplash.com/photo-1554744512-d6c603f27c54?auto=format&fit=crop&w=1200&q=80" 
          alt="Corporate car fleet" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[rgba(0,0,0,0.6)] to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6">
          <p class="text-xl font-bold text-white mb-2">"Corporate fleet 15 unit untuk operational, sudah 2 tahun no issue."</p>
          <p class="text-sm text-white/80">— PT Maju Bersama</p>
        </div>
      </div>
    </div>
  </div>
</section>
