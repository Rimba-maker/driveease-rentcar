---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileBottomBar from '../components/MobileBottomBar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Rental mobil terpercaya, dari city car sampai executive sedan. Lepas kunci atau with driver. Harian, mingguan, bulanan.' } = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
  </head>
  <body class="flex min-h-screen flex-col bg-[var(--color-canvas)] text-[var(--color-ink)] font-sans antialiased">
    <Navbar />
    <main class="flex-1 pb-20 md:pb-0">
      <slot />
    </main>
    <Footer />
    <MobileBottomBar />
  </body>
</html>
